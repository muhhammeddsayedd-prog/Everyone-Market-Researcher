{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyone.film/market-radar/normalized_item.v1.json",
  "title": "Normalized item v1 (collector → ingest.upsert_raw_items)",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "external_id", "actor", "item_type", "url", "published_at", "payload"],
  "properties": {
    "platform": { "enum": ["vimeo", "instagram", "instagram_stories", "website_work_page", "linkedin", "youtube", "news"] },
    "external_id": { "type": "string", "minLength": 1, "description": "Stable source ID: Vimeo video id, IG shortCode (stories: story id/pk), canonical page URL hash for websites, LinkedIn post id, YouTube video id" },
    "actor": { "type": "string", "description": "e.g. apify/instagram-scraper, vimeo-api, youtube-api, apify/website-content-crawler" },
    "item_type": { "enum": ["video", "post", "reel", "carousel", "story", "project_page", "linkedin_post", "news_article", "award_entry"] },
    "url": { "type": "string", "format": "uri" },
    "published_at": { "type": ["string", "null"], "format": "date-time", "description": "UTC ISO 8601. Websites: page date if found, else first_seen time (null allowed)" },
    "title": { "type": ["string", "null"] },
    "caption": { "type": ["string", "null"], "description": "Caption / description / page text excerpt (max 8,000 chars)" },
    "hashtags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "mentions": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Handles without @, lowercase" },
    "tagged_accounts": { "type": "array", "items": { "type": "string" }, "default": [] },
    "duration_seconds": { "type": ["integer", "null"] },
    "thumbnail_url": { "type": ["string", "null"] },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "views": { "type": ["integer", "null"] },
        "plays": { "type": ["integer", "null"] },
        "likes": { "type": ["integer", "null"] },
        "comments": { "type": ["integer", "null"] },
        "shares": { "type": ["integer", "null"] }
      }
    },
    "credits_text": { "type": ["string", "null"], "description": "Credits block if the source has one (Vimeo description, website credits section)" },
    "media_urls": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Linked video URLs found on website pages (Vimeo/YouTube embeds) — used to link items across platforms" },
    "payload": { "type": "object", "description": "Untouched source object" }
  }
}
