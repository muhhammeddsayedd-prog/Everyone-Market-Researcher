# everyone. Market Radar — environment variable NAMES (no values). Copy to apps/web/.env.local for local dev.
# See docs/ENVIRONMENT.md for what each one is and who creates it. Never commit real values.

# --- Public (browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only ---
SUPABASE_SECRET_KEY=            # used only by /api/internal/media-upload-url
EMR_MEDIA_UPLOAD_ENABLED=false  # M06 opt-in local/dev only; Production denied
EMR_MEDIA_PROCESS_ENABLED=false
EMR_MEDIA_BATCH_SIZE=1
EMR_MEDIA_COMMIT_SHA=
EMR_MEDIA_WRITER_PASSWORD=     # Existing dev writer only; never postgres
EMR_MEDIA_PROTECTION_BYPASS=   # Temporary exact-Preview access only, never prod
API_AGENT_DATABASE_URL=         # postgres://api_agent.<ref>:<pw>@<pooler-host>:6543/postgres?sslmode=require
API_KEY_PEPPER=
OPENAI_API_KEY=
OPENAI_MODEL_EMBED=text-embedding-3-small
INTERNAL_WEBHOOK_SECRET=
N8N_WEBHOOK_BASE=
N8N_WEBHOOK_SECRET=

# --- Scripts / CI (not used by the running app) ---
SUPABASE_ACCESS_TOKEN=          # scoped personal access token
SUPABASE_PROJECT_REF_DEV=
SUPABASE_PROJECT_REF_PROD=
# M02 live credentials use scripts/seed/windows encrypted handoffs, not this file.
# PGPASSWORD exists only inside the bounded owner seed child; never add it here.
SEED_DATABASE_URL=              # password-free fixed-project session-pooler URI
SUPABASE_URL=                   # public verified target for owner logo seed
VIMEO_TOKEN=                    # name only; scripts/seed/resolve-accounts.ts (M02)
YOUTUBE_API_KEY=                # name only; scripts/seed/resolve-accounts.ts (M02)
