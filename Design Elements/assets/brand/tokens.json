        "radius-md": "12px",
        "radius-full": "999px"
      },
      "elevation": {
        "elevation-0": "none",
        "elevation-1": "0 0 0 1px var(--color-border)",
        "elevation-2": "0 0 0 1px var(--color-border-strong)",
        "elevation-pop": "0 0 0 1px var(--color-border-strong), 0 16px 40px rgba(0, 0, 0, 0.6)"
      },
      "focus": {
        "focus-ring": "0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-accent)"
      },
