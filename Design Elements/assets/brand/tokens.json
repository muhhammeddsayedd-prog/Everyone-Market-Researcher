        "focus-ring": "0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-accent)"
      },
      "elevation": {
        "elevation-pop": "0 0 0 1px var(--color-border), 0 12px 32px rgba(0, 0, 0, 0.12)"
      }
