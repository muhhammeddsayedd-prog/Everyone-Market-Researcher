        "sidebar-width": "248px",
        "sidebar-width-collapsed": "72px"
      },
      "topbar": {
        "topbar-height": "64px"
      },
      "bottomnav": {
        "bottomnav-height": "64px"
      },
      "content": {
        "content-max": "1440px"
      },
      "gutter": {
        "gutter": "16px",
        "gutter-lg": "32px"
      },
      "z": {
        "z-base": "0",
        "z-sticky": "100",
        "z-sidebar": "200",
        "z-topbar": "300",
        "z-drawer": "400",
        "z-dialog": "500",
        "z-popover": "600",
        "z-toast": "700"
      },
      "duration": {
        "duration-fast": "120ms",
        "duration-base": "200ms",
        "duration-slow": "320ms"
      },
      "ease": {
        "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
        "ease-enter": "cubic-bezier(0, 0, 0, 1)",
